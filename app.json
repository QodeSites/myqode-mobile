{
  "expo": {
    "name": "myQode",
    "slug": "myqode",
    "version": "1.2.5",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qodeinvest.myqode",
      "deploymentTarget": "15.1",
      "buildNumber": "9",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "Used for document scanning",
        "NSPhotoLibraryUsageDescription": "Used to save documents",
        "NSFaceIDUsageDescription": "Use Face ID to securely unlock your myQode portfolio.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A3D2B"
      },
      "package": "com.qodeinvest.myqode",
      "versionCode": 9,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#1A3D2B",
          "enableFullScreenImage_legacy": true,
          "android": {
            "resizeMode": "contain"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to securely unlock your myQode portfolio."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1A3D2B"
        }
      ],
      "@react-native-firebase/app",
      "./plugins/withPodfileFixes"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "myqode",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f886ac20-46c1-4fc9-a126-e1b19163330f"
      }
    }
  }
}
