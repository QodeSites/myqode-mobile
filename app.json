{
  "expo": {
    "name": "myQode",
    "slug": "myqode",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#1A3D2B"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qodeinvest.myqode",
      "deploymentTarget": "15.1",
      "buildNumber": "1",
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#1A3D2B"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Used for document scanning",
        "NSPhotoLibraryUsageDescription": "Used to save documents",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A3D2B"
      },
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#1A3D2B"
      },
      "package": "com.qodeinvest.myqode",
      "versionCode": 1,
      "edgeToEdge": true,
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1A3D2B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": true,
    "scheme": "myqode",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f886ac20-46c1-4fc9-a126-e1b19163330f"
      }
    }
  }
}
